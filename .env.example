# =============================================================================
# CI/CD Woodpecker Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Woodpecker Server
# -----------------------------------------------------------------------------
WOODPECKER_HOST=http://localhost:8000
WOODPECKER_SERVER_ADDR=:8000
WOODPECKER_GRPC_ADDR=:9000

# Secret for server-agent communication (generate with: openssl rand -hex 32)
WOODPECKER_AGENT_SECRET=your-agent-secret-here

# Admin users (comma-separated GitHub usernames)
WOODPECKER_ADMIN=your-github-username

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
# Option 1: GitHub OAuth App
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=your-github-oauth-client-id
WOODPECKER_GITHUB_SECRET=your-github-oauth-client-secret

# Option 2: GitHub App (recommended for private repos)
# WOODPECKER_GITHUB_APP_ID=your-app-id
# WOODPECKER_GITHUB_APP_PRIVATE_KEY=/path/to/private-key.pem

# GitHub API token for issue/PR creation
GITHUB_TOKEN=ghp_your-personal-access-token

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default, good for single-node)
WOODPECKER_DATABASE_DRIVER=sqlite3
WOODPECKER_DATABASE_DATASOURCE=/data/woodpecker.sqlite

# PostgreSQL (recommended for production)
# WOODPECKER_DATABASE_DRIVER=postgres
# WOODPECKER_DATABASE_DATASOURCE=postgres://user:pass@host:5432/woodpecker?sslmode=disable

# -----------------------------------------------------------------------------
# AI Auto-fix Configuration
# -----------------------------------------------------------------------------
# AI Provider: claude-code | codex | openhands | opencode
AI_FIX_PROVIDER=claude-code

# API Keys (based on provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# AI Fix behavior
AI_FIX_ENABLED=true
AI_FIX_MAX_ATTEMPTS=3
AI_FIX_TIMEOUT=300

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# Deploy target: local | remote | kubernetes
DEPLOY_TARGET=local

# Docker deployment
DEPLOY_DOCKER_HOST=unix:///var/run/docker.sock
# DEPLOY_DOCKER_HOST=tcp://remote-host:2375

# Remote SSH deployment
# DEPLOY_SSH_HOST=your-server.com
# DEPLOY_SSH_USER=deploy
# DEPLOY_SSH_KEY=/path/to/ssh/key

# Kubernetes deployment
# DEPLOY_K8S_CONTEXT=your-cluster
# DEPLOY_K8S_NAMESPACE=production

# -----------------------------------------------------------------------------
# Notification & Webhook
# -----------------------------------------------------------------------------
# Webhook endpoint for external notifications
WEBHOOK_ENDPOINT=http://localhost:8080/webhook
WEBHOOK_SECRET=your-webhook-secret

# Polling interval (seconds)
POLL_INTERVAL=60

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Discord notifications (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx

# -----------------------------------------------------------------------------
# Security Scanning
# -----------------------------------------------------------------------------
# Trivy configuration
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM
TRIVY_EXIT_CODE=1
TRIVY_IGNORE_UNFIXED=true

# -----------------------------------------------------------------------------
# Volumes (local paths for bind mounts)
# -----------------------------------------------------------------------------
WOODPECKER_DATA_DIR=./data/woodpecker
WOODPECKER_LOGS_DIR=./data/logs
PROJECTS_DIR=./data/projects

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./data/logs/ci-cd.log
